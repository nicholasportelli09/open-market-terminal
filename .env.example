# Copy to .env.local and fill in what you want. Every value is optional; see README.md.

# --- AI (server keys; used only for accounts in AI_ALLOWED_USER_IDS when sign-in is set up) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# auto (Gemini, then Anthropic) | gemini | anthropic
AI_PROVIDER=
ANTHROPIC_MODEL=
GEMINI_MODEL=
# Comma-separated Supabase user ids allowed to use the server's AI keys
AI_ALLOWED_USER_IDS=
# 1 = every signed-in account may use the server's AI keys (not recommended for a public site)
AI_OPEN_TO_SIGNED_IN=
# 1 = open the server's AI keys without sign-in on a production build (private deployments only)
AI_OPEN_WITHOUT_AUTH=
AI_WEEKLY_BUDGET_USD=
AI_DAILY_LIMIT=

# --- Sign-in and sync (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Licensed data (analyst ratings, price targets) ---
FMP_API_KEY=
FMP_DAILY_LIMIT=
FINNHUB_API_KEY=

# --- SEC EDGAR asks for "App name contact@email" ---
SEC_USER_AGENT=
